# ---------------------------------------------------------------------------
# Tetherify — local environment
#
# Copy to .env and fill in. .env is git-ignored; never commit real values.
#   cp .env.example .env
#
# IMPORTANT: none of this reaches the deployed bot. Telegram's serverless
# runtime has no environment variables and needs none — the Bot API is already
# authenticated inside the sandbox, so the bot token never appears in the code
# that runs in production. These values exist purely for the local CLI and CI.
# ---------------------------------------------------------------------------

# The tgcloud CLI access token. This is the ONE real secret in the project.
# Get it from: @BotFather -> your bot -> Serverless -> CLI Access -> Access token
# Format: app<id>:<secret>   (it is NOT the same as the bot's API token)
#
# In GitHub Actions this is the TGCLOUD_TOKEN repository secret:
#   Settings -> Secrets and variables -> Actions -> New repository secret
TGCLOUD_TOKEN=app000000000:replace_me

# Optional. Only used by local one-off scripts that talk to the Bot API
# directly (for example checking getMe). The deployed bot never reads this.
# Get it from: @BotFather -> your bot -> API Token
TELEGRAM_BOT_TOKEN=

# Optional. Documents who the bot admin is. The value the running bot actually
# uses is the ADMIN_IDS constant in lib/config.js — a Telegram user id is not a
# secret, and the runtime cannot read env vars anyway.
ADMIN_USER_ID=
